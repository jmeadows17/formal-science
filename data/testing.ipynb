   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "import Mathlib.Tactic\n",
      "import Mathlib.Analysis.SpecialFunctions.Sqrt\n",
      "import Mathlib.Analysis.Calculus.Deriv.Basic\n",
      "import Mathlib.Analysis.Calculus.MeanValue\n",
      "import Mathlib.Data.Complex.Basic\n",
      "\n",
      "open Real\n",
      "open scoped BigOperators\n",
      "\n",
      "namespace AutoFormal\n",
      "\n",
      "-- C1 (Lorentz-force x–component from Euler–Lagrange rearrangement)\n",
      "theorem C1_LorentzForce_x\n",
      "    (q F Axt Axy Axz Ayx Azx phix ydot zdot Ex By Bz : ℝ)\n",
      "    (hEL :\n",
      "      F + q*(Axt + Axy*ydot + Axz*zdot) = q*(Ayx*ydot + Azx*zdot) - q*phix)\n",
      "    (hEx : Ex = -(phix + Axt))\n",
      "    (hBy : By = Axz - Azx)\n",
      "    (hBz : Bz = Ayx - Axy) :\n",
      "    F = q*Ex + q*(ydot*Bz - zdot*By) := by\n",
      "  have : F\n",
      "      = - q*(Axt + Axy*ydot + Axz*zdot)\n",
      "        + q*(Ayx*ydot + Azx*zdot) - q*phix := by\n",
      "    linarith\n",
      "  calc\n",
      "    F\n",
      "        = - q*(Axt + Axy*ydot + Axz*zdot)\n",
      "          + q*(Ayx*ydot + Azx*zdot) - q*phix := this\n",
      "    _   = - q*Axt - q*Axy*ydot - q*Axz*zdot\n",
      "          + q*Ayx*ydot + q*Azx*zdot - q*phix := by ring\n",
      "    _   = q*(-(phix + Axt))\n",
      "          + q*(ydot*(Ayx - Axy))\n",
      "          + q*(zdot*(Azx - Axz)) := by ring\n",
      "    _   = q*Ex + q*(ydot*Bz) + q*(zdot*(-By)) := by\n",
      "            simpa [hEx, hBy, hBz, sub_eq_add_neg]\n",
      "    _   = q*Ex + q*(ydot*Bz - zdot*By) := by ring\n",
      "\n",
      "\n"
     ]
    }
   ],
   "source": [
